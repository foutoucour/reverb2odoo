<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ gear_name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* Palette — GitHub's light theme (Primer), mirroring cot-ci-hub's hub.css
       token set so the card reads as part of the same family: white canvas on a
       subtle grey page, hairline #d1d9e0 borders, near-black text, muted labels,
       and no gradients or glow. Light mode only. */
    :root {
      --bg:          #f6f8fa;  /* canvas.subtle — the page behind the card */
      --card:        #ffffff;  /* canvas.default */
      --surface:     #ffffff;
      --surface2:    #f6f8fa;
      --border:      #d1d9e0;
      --border2:     #d8dee4;
      --text:        #1f2328;
      --text-strong: #010409;
      --muted:       #59636e;
      --radius:      6px;

      /* The two SVG diagrams below spell their colours as literals rather than
         var(), because presentation attributes (fill=, stroke=) are not
         reliably substituted. They draw from the same Primer set: #d1d9e0 for
         hairlines and construction marks, #59636e for annotation, #eaeef2 for
         a neutral fill, and success #1a7f37 / attention #9a6700 / danger
         #cf222e on the weight gauge — the one place the card spends colour. */

      /* Layout — 3 columns: photo rail + two spec columns */
      --card-max:  1560px;
      --col-media: 460px;
      --gutter:    28px;
      --photo-max-h: 560px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans",
                   Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 24px 16px;
    }

    .card {
      background: var(--card);
      width: 100%;
      max-width: var(--card-max);
      box-shadow: 0 1px 3px rgba(31,35,40,.06), 0 8px 24px rgba(31,35,40,.12);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      display: grid;
      grid-template-columns: var(--col-media) 1fr 1fr;
      grid-template-rows: 1fr auto;
    }

    /* Column 1 — photo above the title, filling the full card height */
    .media {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      border-right: 1px solid var(--border);
    }

    /* ── Photo ── */
    .photos {
      width: 100%;
      overflow: hidden;
      background: var(--surface2);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .photos img {
      width: 100%;
      height: auto;
      /* Cap portrait shots — guitars are often photographed vertically, and an
         uncapped tall image pushes the card past the one-screen budget.
         object-fit letterboxes the overflow rather than distorting it. */
      max-height: var(--photo-max-h);
      object-fit: contain;
      display: block;
    }
    .photos-empty {
      flex: 1;
      width: 100%;
      min-height: 220px;
      background: var(--surface2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      font-size: 0.85rem;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    /* ── Header ── */
    .header {
      padding: 24px 28px;
      border-bottom: 1px solid var(--border);
      background: var(--surface2);
    }
    .title {
      font-size: 1.5rem;
      font-weight: 300;
      color: var(--text-strong);
      letter-spacing: -.02em;
      line-height: 1.15;
    }
    .title strong {
      font-weight: 600;
      color: var(--text-strong);
    }

    /* ── Body ── */
    .body {
      grid-column: 2 / -1;
      grid-row: 1;
      padding: 4px 32px 28px;
      columns: 2;
      column-gap: var(--gutter);
    }

    /* ── Section ── */
    .section {
      padding-top: 20px;
      -webkit-column-break-inside: avoid;
      break-inside: avoid;
    }
    .section-title {
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .18em;
      color: var(--muted);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
    }

    /* Tiles */
    .specs {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    /* Wide variant — two large tiles (used for pickups, etc.) */
    .specs--wide {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
    .specs--wide .spec { padding: 20px 24px; }
    .specs--wide .spec-label { font-size: 0.68rem; }
    .specs--wide .spec-value { font-size: 1.15rem; margin-top: 8px; }
    .spec {
      background: var(--surface);
      padding: 14px 18px;
      transition: background .15s;
    }
    .spec-label {
      font-size: 0.62rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .1em;
    }
    .spec-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-strong);
      margin-top: 5px;
    }

    /* Rows (measurements, materials) */
    .rows {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .mrow {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding: 11px 18px;
      border-bottom: 1px solid var(--border2);
    }
    .mrow:last-child { border-bottom: none; }
    .mrow:nth-child(even) { background: var(--surface2); }
    .mrow-label {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .08em;
      flex-shrink: 0;
      margin-right: 24px;
    }
    .mrow-value {
      font-size: 0.9rem;
      color: var(--text);
      text-align: right;
      white-space: pre-line;
    }

    /* Footer */
    .footer {
      grid-column: 1 / -1;
      grid-row: 2;
      padding: 14px 32px;
      border-top: 1px solid var(--border);
      font-size: 0.68rem;
      color: var(--muted);
      letter-spacing: .06em;
      text-align: right;
      background: var(--surface2);
    }

    /* ── Narrow screens — fall back to the original single column ── */
    @media (max-width: 1100px) {
      .card { display: block; max-width: 720px; }
      .media { border-right: none; }
      .photos { max-height: 480px; }
      .photos img { max-height: 480px; object-fit: cover; }
      .title { font-size: 2rem; }
      .body { padding: 0 40px 40px; columns: 1; }
      .section { padding-top: 32px; }
    }
  </style>
</head>
<body>
  <div class="card">

    <div class="media">
      <div class="header">
        <div class="title">
          <strong>{{ model_name }}</strong>
        </div>
      </div>

      {# Photo #}
      {% if photos %}
      <div class="photos">
        <img src="data:image/jpeg;base64,{{ photos[0] }}" alt="gear photo" />
      </div>
      {% else %}
      <div class="photos-empty">No photo</div>
      {% endif %}
    </div>

    <div class="body">
      {% for group in spec_groups %}
      <div class="section">
        <div class="section-title">{{ group.title }}</div>
        {% if group.style == "rows" %}
        <div class="rows">
          {% for label, value in group.specs %}
          <div class="mrow">
            <span class="mrow-label">{{ label }}</span>
            <span class="mrow-value">{{ value | replace("\n", "<br>") | safe }}</span>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <div class="specs{% if group.style == 'tiles-wide' %} specs--wide{% endif %}">
          {% for label, value in group.specs %}
          <div class="spec">
            <div class="spec-label">{{ label }}</div>
            <div class="spec-value">{{ value }}</div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}

      {# ── Weight gauge ── #}
      {% if weight_lbs > 0 %}
      {% set WMN  = 5.0 %}
      {% set WMX  = 11.0 %}
      {% set TL   = 48 %}
      {% set TR   = 352 %}
      {% set TW   = TR - TL %}
      {% set TY   = 46 %}
      {% set TH   = 8 %}
      {% set CLW  = [weight_lbs, WMN] | max %}
      {% set CLW  = [CLW, WMX] | min %}
      {% set PCT  = (CLW - WMN) / (WMX - WMN) %}
      {% set MX   = TL + PCT * TW %}
      {% set WDISP = weight_lbs | round(1) %}
      <div class="section">
        <div class="section-title">Weight</div>
        <svg viewBox="0 0 400 78"
             style="width:100%;display:block"
             xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="wgrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="#1a7f37"/>
              <stop offset="45%"  stop-color="#9a6700"/>
              <stop offset="100%" stop-color="#cf222e"/>
            </linearGradient>
            <clipPath id="wclip">
              <rect x="{{ TL }}" y="{{ TY - TH / 2 }}" width="{{ PCT * TW }}" height="{{ TH }}" rx="4"/>
            </clipPath>
          </defs>

          {# Track background #}
          <rect x="{{ TL }}" y="{{ TY - TH / 2 }}" width="{{ TW }}" height="{{ TH }}" rx="4" fill="#eaeef2"/>

          {# Gradient fill up to marker position #}
          <rect x="{{ TL }}" y="{{ TY - TH / 2 }}" width="{{ TW }}" height="{{ TH }}" rx="4"
                fill="url(#wgrad)" clip-path="url(#wclip)"/>

          {# Tick marks and labels #}
          {% for i in range(7) %}
          {% set TX = TL + i / 6.0 * TW %}
          <line x1="{{ TX }}" y1="{{ TY + TH / 2 }}" x2="{{ TX }}" y2="{{ TY + TH / 2 + 5 }}"
                stroke="#d1d9e0" stroke-width="1"/>
          <text x="{{ TX }}" y="{{ TY + TH / 2 + 16 }}" text-anchor="middle"
                font-size="9" fill="#59636e"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">{{ 5 + i }}</text>
          {% endfor %}

          {# Range labels #}
          <text x="{{ TL }}" y="{{ TY + TH / 2 + 28 }}" text-anchor="middle"
                font-size="8" fill="#1a7f37" letter-spacing=".5"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">LIGHT</text>
          <text x="{{ TR }}" y="{{ TY + TH / 2 + 28 }}" text-anchor="middle"
                font-size="8" fill="#cf222e" letter-spacing=".5"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">HEAVY</text>

          {# Marker stem #}
          <line x1="{{ MX }}" y1="{{ TY - TH / 2 - 2 }}" x2="{{ MX }}" y2="{{ TY - TH / 2 - 10 }}"
                stroke="#010409" stroke-width="1.5"/>

          {# Marker triangle (pointing down) #}
          <polygon points="{{ MX }},{{ TY - TH / 2 - 1 }} {{ MX - 5 }},{{ TY - TH / 2 - 10 }} {{ MX + 5 }},{{ TY - TH / 2 - 10 }}"
                   fill="#010409"/>

          {# Weight label #}
          <text x="{{ MX }}" y="{{ TY - TH / 2 - 14 }}" text-anchor="middle"
                font-size="9.5" font-weight="700" fill="#010409"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">{{ WDISP }} lbs</text>
        </svg>
      </div>
      {% endif %}

      {# ── Neck Profile diagram ── #}
      {% if neck_profile and neck_profile.nut_width_mm > 0 %}
      {% set NW   = neck_profile.nut_width_mm %}
      {% set T1   = neck_profile.thickness_1st_mm %}
      {% set T12  = neck_profile.thickness_12th_mm %}
      {% set SC   = 110.0 / NW %}
      {% set W    = 110 %}
      {% set H1   = T1  * SC %}
      {% set H2   = T12 * SC %}
      {% if H1 >= H2 %}{% set MH = H1 %}{% else %}{% set MH = H2 %}{% endif %}
      {% set PL   = 90 %}
      {% set PT   = 36 %}
      {% set GAP  = 56 %}
      {% set DG   = 16 %}
      {% set FH   = 5  %}
      {% set X1   = PL %}
      {% set X2   = PL + W + GAP %}
      {% set YT   = PT %}
      {% set SVW  = PL + W + GAP + W + PL %}
      {% set SVH  = PT + MH + FH + DG + 36 %}
      <div class="section">
        <div class="section-title">Neck Profile</div>
        <svg viewBox="0 0 {{ SVW }} {{ SVH }}"
             style="width:100%;display:block;margin:0 auto"
             xmlns="http://www.w3.org/2000/svg">
          <defs>
            <marker id="ah" viewBox="0 0 10 10" refX="5" refY="5"
                    markerWidth="5" markerHeight="5" orient="auto-start-reverse">
              <path d="M 0 1 L 9 5 L 0 9 Z" fill="#59636e"/>
            </marker>
          </defs>

          {# ── 1st Fret ── #}
          <text x="{{ X1 + W / 2 }}" y="{{ YT - 10 }}"
                text-anchor="middle" font-size="9" letter-spacing="1.5" fill="#59636e" font-weight="700"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">1ST FRET</text>
          <path d="M {{ X1 }} {{ YT + FH }} L {{ X1 + W }} {{ YT + FH }} A {{ W / 2 }} {{ H1 }} 0 0 1 {{ X1 }} {{ YT + FH }} Z"
                fill="#eaeef2" stroke="#1f2328" stroke-width="1.8"/>
          <rect x="{{ X1 }}" y="{{ YT }}" width="{{ W }}" height="{{ FH }}" fill="#59636e" rx="1"/>
          {% set DY1 = YT + FH + H1 + DG %}
          <line x1="{{ X1 }}" y1="{{ YT + FH + H1 }}" x2="{{ X1 }}" y2="{{ DY1 + 2 }}" stroke="#d1d9e0" stroke-width="0.7" stroke-dasharray="3 2"/>
          <line x1="{{ X1 + W }}" y1="{{ YT + FH + H1 }}" x2="{{ X1 + W }}" y2="{{ DY1 + 2 }}" stroke="#d1d9e0" stroke-width="0.7" stroke-dasharray="3 2"/>
          <line x1="{{ X1 }}" y1="{{ DY1 }}" x2="{{ X1 + W }}" y2="{{ DY1 }}" stroke="#59636e" stroke-width="1" marker-start="url(#ah)" marker-end="url(#ah)"/>
          <text x="{{ X1 + W / 2 }}" y="{{ DY1 + 13 }}" text-anchor="middle" font-size="9" fill="#1f2328"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">{{ neck_profile.nut_width_disp }}</text>
          {% set LX1 = X1 - DG %}
          <line x1="{{ X1 }}" y1="{{ YT + FH }}" x2="{{ LX1 - 2 }}" y2="{{ YT + FH }}" stroke="#d1d9e0" stroke-width="0.7" stroke-dasharray="3 2"/>
          <line x1="{{ X1 }}" y1="{{ YT + FH + H1 }}" x2="{{ LX1 - 2 }}" y2="{{ YT + FH + H1 }}" stroke="#d1d9e0" stroke-width="0.7" stroke-dasharray="3 2"/>
          <line x1="{{ LX1 }}" y1="{{ YT + FH }}" x2="{{ LX1 }}" y2="{{ YT + FH + H1 }}" stroke="#59636e" stroke-width="1" marker-start="url(#ah)" marker-end="url(#ah)"/>
          <text x="{{ LX1 - 5 }}" y="{{ YT + FH + H1 / 2 + 3 }}" text-anchor="end" font-size="9" fill="#1f2328"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">{{ neck_profile.thickness_1st_disp }}</text>

          {# ── 12th Fret ── #}
          <text x="{{ X2 + W / 2 }}" y="{{ YT - 10 }}"
                text-anchor="middle" font-size="9" letter-spacing="1.5" fill="#59636e" font-weight="700"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">12TH FRET</text>
          <path d="M {{ X2 }} {{ YT + FH }} L {{ X2 + W }} {{ YT + FH }} A {{ W / 2 }} {{ H2 }} 0 0 1 {{ X2 }} {{ YT + FH }} Z"
                fill="#eaeef2" stroke="#1f2328" stroke-width="1.8"/>
          <rect x="{{ X2 }}" y="{{ YT }}" width="{{ W }}" height="{{ FH }}" fill="#59636e" rx="1"/>
          {% set RX2 = X2 + W + DG %}
          <line x1="{{ X2 + W }}" y1="{{ YT + FH }}" x2="{{ RX2 + 2 }}" y2="{{ YT + FH }}" stroke="#d1d9e0" stroke-width="0.7" stroke-dasharray="3 2"/>
          <line x1="{{ X2 + W }}" y1="{{ YT + FH + H2 }}" x2="{{ RX2 + 2 }}" y2="{{ YT + FH + H2 }}" stroke="#d1d9e0" stroke-width="0.7" stroke-dasharray="3 2"/>
          <line x1="{{ RX2 }}" y1="{{ YT + FH }}" x2="{{ RX2 }}" y2="{{ YT + FH + H2 }}" stroke="#59636e" stroke-width="1" marker-start="url(#ah)" marker-end="url(#ah)"/>
          <text x="{{ RX2 + 5 }}" y="{{ YT + FH + H2 / 2 + 3 }}" text-anchor="start" font-size="9" fill="#1f2328"
                font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">{{ neck_profile.thickness_12th_disp }}</text>

        </svg>
      </div>
      {% endif %}

    </div>

    <div class="footer">lespaulpedia</div>
  </div>
</body>
</html>
